# ─── VeriPAY AI configuration ─────────────────────────────────────────────

# Intent engine. Optional: with no key, the deterministic intent engine runs
# (no LLM, no cost). With a key, Claude refines the same fields.
ANTHROPIC_API_KEY=
VERIPAYAI_MODEL=claude-opus-4-8

# ─── Agent guardrails (AI-layer) ──────────────────────────────────────────
# Per-transaction limits, by asset. Stablecoins are dollar-pegged so their cap
# is a straight USD amount; MON is capped generously until live USD pricing.
PAYAI_MAX_USD=10000
PAYAI_MAX_MON=100000
VERIPAYAI_DEFAULT_NETWORK=monad

# Platform fee, in basis points (100 = 1%). Zero today — no fee is charged or
# moved anywhere. See lib/payment/fees.ts before ever setting this above 0;
# turning it on also requires deciding where the fee goes on-chain.
PLATFORM_FEE_BPS=0

# ─── Execution layer ──────────────────────────────────────────────────────
# simulation → simulated execution (default; offline-safe).
# monad      → real on-chain USDC/MON transfers signed by the agent wallet.
PAYAI_MODE=simulation

# ─── Monad blockchain ─────────────────────────────────────────────────────
# Active network (testnet first; flip to mainnet when ready).
MONAD_NETWORK=testnet
# RPC URLs (separate testnet/mainnet configs).
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz
# Agent signing wallet — server-only, NEVER exposed to the client.
# Use a dedicated, low-balance hot wallet funded from the Monad faucet.
MONAD_AGENT_PRIVATE_KEY=
# Stablecoin contract per network (testnet defaults to sandbox aUSDC).
MONAD_TESTNET_USDC=0xaC0893567D43C3E7e6e35a72803df05416C1f20D
MONAD_MAINNET_USDC=
MONAD_USDC_DECIMALS=6

# ─── On-chain execution suite (PaymentExecutor + MerchantRegistry) ─────────
# Network-specific addresses win over the shared fallback, so testnet and
# mainnet stay fully separate. Deploy with: cd contracts && npx hardhat run
# scripts/deploy-suite.js --network <monadTestnet|monad>
MONAD_TESTNET_PAYMENT_EXECUTOR=
MONAD_TESTNET_MERCHANT_REGISTRY=
MONAD_MAINNET_PAYMENT_EXECUTOR=
MONAD_MAINNET_MERCHANT_REGISTRY=
# Shared fallback (used if the network-specific one above is unset):
MONAD_PAYMENT_EXECUTOR=
MONAD_MERCHANT_REGISTRY=

# ─── API security ──────────────────────────────────────────────────────────
# Shared secret for write endpoints (/api/agent, /api/onchain, /api/links).
# REQUIRED before exposing a live signer: if PAYAI_MODE=monad and a key is
# set, write routes refuse unauthenticated requests (fail-closed). Send as
# `x-api-key: <key>` or `Authorization: Bearer <key>`.
VERIPAYAI_API_KEY=

# Validation engine tuning.
PAYAI_TRAVEL_RULE_THRESHOLD=250
PAYAI_DENYLIST=sanctioned,blocked,ofac
# Exact wallet addresses to block (comma-separated). Screens the real recipient
# address. Replace with a real screening provider for production.
PAYAI_ADDRESS_DENYLIST=

# WalletConnect (Reown) — enables QR / mobile deep-link connect for any wallet.
# Create a free project id at https://dashboard.reown.com and paste it here.
# Public by design (inlined into the client bundle). Leave empty to hide the
# WalletConnect option.
NEXT_PUBLIC_WC_PROJECT_ID=

# Google Analytics (GA4) — Measurement ID from analytics.google.com
# (Admin → Data Streams → your web stream → "G-XXXXXXXXXX").
# Public by design (inlined into the client bundle). Leave empty to disable
# GA entirely (e.g. local dev).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
