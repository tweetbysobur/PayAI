{
  "name": "monad-nft-mint-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot that mints NFTs on Monad. Custodial and non-custodial modes. Contract address is set at runtime.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "@types/node": "^20.14.0"
  }
}
